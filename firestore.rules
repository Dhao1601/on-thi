rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'uid', 'subj', 'set', 'score', 'total', 'ms', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 40
        && request.resource.data.subj in ['AET', 'HOD', 'IPR', 'MLN131']
        && request.resource.data.set is string && request.resource.data.set.size() <= 8
        && request.resource.data.score is int && request.resource.data.total is int
        && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
        && request.resource.data.total > 0 && request.resource.data.total <= 60
        && request.resource.data.ms is int && request.resource.data.ms >= 60000
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
  }
}
